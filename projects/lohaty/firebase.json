{
 "firestore": {
  "rules": "firestore.rules",
  "indexes": "firestore.indexes.json"
 },
 "functions": [
  {
   "source": "functions"
  }
 ],
 "hosting": {
  "public": "public",
  "ignore": [
   "firebase.json",
   "**/.*"
  ],
  "headers": [
   {
    "source": "**/*.@(html|js|webmanifest)",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   },
   {
    "source": "/",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   }
  ]
 }
}